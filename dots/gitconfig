[user]
    name = James O'Beirne
    email = james.obeirne@pm.me
	signingkey = key::ssh-rsa  cardno:7826579
[core]
    editor = vim
    pager = delta
[commit]
    gpgsign = true
    verbose = true
[delta]
    features = line-numbers decorations
    # Don't set this here! It's inherited from BAT_THEME in zshrc.
    # syntax-theme = 1337
[interactive]
    diffFilter = delta --color-only
[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    # file-decoration-style = none
[alias]
    unstage = reset HEAD
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative --color
    to = checkout
    newb = checkout -b
    mm = !git checkout master && git pull origin master && git checkout - && git merge master
    co = checkout
[push]
    default = simple
    autoSetupRemote = true
[pull]
    rebase = true
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[diff]
    algorithm = histogram
    colorMoved = dimmed_zebra
    mnemonicPrefix = true
[color]
    ui = always
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green bold
    newHighlight = green bold 22
[color "diff"]
    commit = green
    meta = yellow
    frag = cyan
    old = red
    new = green
    whitespace = red reverse
[gcrypt]
    participants = 602FF17CFE7726E077AB497EC597111CC9A2855F
[merge]
	conflictStyle = diff3
[safe]
	directory = /bitcoin
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rerere]
    enabled = true        # Record and reuse conflict resolutions
    autoupdate = true     # Apply stored conflict resolutions automatically
[url "ssh://git@git.j.co:222/"]
    insteadOf = git@git.j.co:
[credential]
	helper = store
[gpg]
	format = ssh
